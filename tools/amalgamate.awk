# Amalgamate the emulator sources into a single self-contained C file.
#
# Run with the root .c files as arguments, in link order:
#   awk -f tools/amalgamate.awk cdrom.c cpu.c ... > jonboy.c
#
# Each local include ("...") is inlined the first time it is seen and skipped
# afterwards, so a header is expanded at the point it is first needed and its
# dependencies fall into place without a hand-maintained order. System includes
# (<...>) are passed through; their own guards make the repeats harmless.

function emit(file,    line, hdr) {
    if (file in seen) {
        return;
    }
    seen[file] = 1;

    print "/* ---- " file " ---- */";
    while ((getline line < file) > 0) {
        if (line ~ /^[ \t]*#[ \t]*include[ \t]*"/) {
            hdr = line;
            sub(/^[ \t]*#[ \t]*include[ \t]*"/, "", hdr);
            sub(/".*$/, "", hdr);
            emit(hdr);
        } else {
            print line;
        }
    }
    close(file);
}

BEGIN {
    print "/* Amalgamated single-file build of jonboy, generated by the Makefile.";
    print "   Do not edit; edit the individual sources and regenerate. */";
    for (i = 1; i < ARGC; i++) {
        emit(ARGV[i]);
    }
}
